{
  "$schema": "../vendor/marinos/filter-panel.schema.json",
  "schemaVersion": "1.0.0",
  "search": {
    "id": "line-search",
    "fields": [
      "title",
      "area",
      "department",
      "kind"
    ],
    "match": "phrase"
  },
  "groups": [
    {
      "type": "radio",
      "id": "book",
      "label": "Budget books",
      "options": {
        "values": [
          {
            "value": "./index.html",
            "label": "FY 2026-27 Proposed"
          },
          {
            "value": "./fy2025-26/index.html",
            "label": "FY 2025-26 Final"
          }
        ]
      },
      "default": "./index.html",
      "param": "book"
    },
    {
      "type": "checkbox",
      "id": "measure",
      "label": "Show",
      "collapsed": false,
      "default": [
        "exp"
      ],
      "options": {
        "values": [
          {
            "value": "exp",
            "label": "Total expenditures"
          },
          {
            "value": "rev",
            "label": "Revenues"
          },
          {
            "value": "ncc",
            "label": "Net County cost"
          }
        ]
      },
      "param": "measure",
      "separator": ","
    },
    {
      "type": "checkbox",
      "id": "year",
      "label": "Years",
      "collapsed": false,
      "default": [
        "2"
      ],
      "options": {
        "values": [
          {
            "value": "0",
            "label": "FY 2024-25 Actuals"
          },
          {
            "value": "1",
            "label": "FY 2025-26 Approved"
          },
          {
            "value": "2",
            "label": "FY 2026-27 Proposed"
          }
        ]
      },
      "param": "year",
      "separator": ","
    },
    {
      "type": "checkbox",
      "id": "change",
      "label": "Compare",
      "collapsed": false,
      "default": [],
      "options": {
        "values": [
          {
            "value": "1",
            "label": "Show the change between years"
          }
        ]
      },
      "param": "change",
      "separator": ","
    },
    {
      "type": "checkbox",
      "id": "area",
      "label": "Service areas",
      "allLabel": "All service areas",
      "options": {
        "values": [
          {
            "value": "Administration and Finance",
            "label": "Administration and Finance"
          },
          {
            "value": "Community Development and Public Works",
            "label": "Community Development and Public Works"
          },
          {
            "value": "Community Services",
            "label": "Community Services"
          },
          {
            "value": "Health and Human Services",
            "label": "Health and Human Services"
          },
          {
            "value": "Public Safety",
            "label": "Public Safety"
          }
        ]
      },
      "param": "area",
      "field": "area"
    },
    {
