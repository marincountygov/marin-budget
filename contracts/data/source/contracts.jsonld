  "_conversion": {
    "sourceFile": "Contract Data 7.1.2023-11.6.csv",
    "recordCount": 5256,
    "currencyAssumption": "USD",
    "profiles": [
      "https://schema.govfresh.com/profiles/procurement/",
      "https://schema.govfresh.com/profiles/budget/"
    ],
    "mappingNotes": [
      "Each source contract becomes one ContractingProcess with a Tender, Award, Contract, supplier Party reference, and department procuring-entity reference.",
      "Revised Total maps to Contract.value using the budget profile MonetaryAmount shape.",
      "Contract Method is preserved as Tender.procurementMethodDetails; it is not mapped to procurementMethod because source values do not establish OCDS open/selective/limited/direct competition methods.",
      "Estimated Start Date and Estimated Completion Date map to Contract.periodStart and Contract.periodEnd.",
      "Entered Date is preserved as a source property and is not treated as dateSigned because the source does not establish that meaning.",
      "Liquidated Total is not mapped to amountPaid because the source label does not establish that it represents payments.",
      "Fiscal year, period, administrator, project, liquidated total, encumbrance balance, open purchase order total, source status, type, and subtype are preserved as schema.org PropertyValue entries.",
      "No Budget or BudgetLine entities are created because the source does not contain an appropriation/budget-line identifier or enough information to assert a budget allocation.",
      "POSTED maps to Contract.status active. CLOSED maps to terminated only because the current schemaGov ContractStatus list has no completed/closed value; review this mapping before publication.",
      "Supplier identifiers use the local Marin vendor number from the source, not a national company-register identifier; enrich with EIN/LEI or another org-id.guide identifier when available.",
      "URN identifiers are used as stable file-local identifiers because no public dereferenceable Marin procurement ID namespace was supplied."
    ],
    "warnings": {
      "closed_status_mapped_to_terminated": 3122,
      "vendor_missing_local_id": 0
    },
    "dataset": "contracts",
    "vendorDataset": "vendors.jsonld",
    "vendorCountReferenced": 1654,
    "organizationReferences": "County and department @id references are intentionally external and can resolve against a separate organizations.jsonld dataset."
  }
}